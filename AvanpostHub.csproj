<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseAppHost>true</UseAppHost>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AvanpostHub</AssemblyName>
    <Version>0.4.0</Version>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <FileVersion>0.4.0.0</FileVersion>
    <RootNamespace>AvanpostHub</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Avanpost Hub</AssemblyTitle>
    <Product>Avanpost</Product>
    <Description>Локальный хаб рыночных данных и overlay-разметки для индикаторов Tiger.com</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- Tests — отдельный проект. Иначе его Program.Main попадает в WinExe и даёт CS0017. -->
    <Compile Remove="Tests/**/*.cs" />
  </ItemGroup>
</Project>
