<Window x:Class="AvanpostHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Avanpost Hub"
        Width="660"
        Height="500"
        MinWidth="580"
        MinHeight="430"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F7"
        Closing="Window_Closing">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Avanpost Hub" FontSize="26" FontWeight="SemiBold" Foreground="#20242A"/>
            <TextBlock Margin="0,4,0,18"
                       Text="Локальный хаб рыночных данных и overlay-разметки для индикаторов Tiger.com."
                       Foreground="#5B6470" TextWrapping="Wrap"/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="Подключение" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Порт локального WS"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="PortBox" Width="120" Height="28"
                         HorizontalAlignment="Left" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,10,0,0" VerticalAlignment="Center" Text="Адрес"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="EndpointText" Margin="0,10,0,0"
                           VerticalAlignment="Center" Foreground="#2B5F8A" Text="ws://127.0.0.1:7830/ws"/>

                <CheckBox Grid.Row="2" Grid.Column="1" x:Name="AutostartCheck" Margin="0,14,0,0"
                          Content="Запускать при входе в Windows (HKCU, без прав администратора)"/>

                <CheckBox Grid.Row="3" Grid.Column="1" x:Name="StartMinimizedCheck" Margin="0,10,0,0"
                          Content="При запуске сворачиваться в трей"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,12,0,0" VerticalAlignment="Center"
                           Text="Screener API"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="ScreenerUrlBox" Margin="0,12,0,0"
                         Height="28" VerticalContentAlignment="Center"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Состояние" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Сервер"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="StatusText" FontWeight="SemiBold" Text="остановлен"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" Text="Клиенты"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ClientsText" Margin="0,8,0,0" Text="0 клиентов · 0 подписок"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" Text="Данные"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="FeatureText" Margin="0,8,0,0"
                           Text="0 серий · 0 закрытых баров"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8,0,0" Text="Uptime"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="UptimeText" Margin="0,8,0,0" Text="—"/>
            </Grid>
        </GroupBox>

        <Border Grid.Row="3" Background="#FFF7E8" BorderBrush="#F0D39A" BorderThickness="1"
                CornerRadius="4" Padding="12" VerticalAlignment="Top">
            <TextBlock x:Name="ErrorText" Foreground="#8A5A00" TextWrapping="Wrap"
                       Text="Подключите биржевые коннекторы: пока хаб принимает транспорт и хранит признаки, но рыночных источников ещё нет."/>
        </Border>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="SaveButton" Content="Сохранить" Width="110" Height="34"
                        Click="Save_Click"/>
                <Button x:Name="RestartButton" Content="Перезапустить" Width="125" Height="34"
                        Margin="10,0,0,0" Click="Restart_Click"/>
                <Button x:Name="OpenLogsButton" Content="Открыть логи" Width="120" Height="34"
                        Margin="10,0,0,0" Click="OpenLogs_Click"/>
            </StackPanel>
            <Button HorizontalAlignment="Right" Content="Свернуть в трей" Width="135" Height="34"
                    Click="Hide_Click"/>
        </Grid>
    </Grid>
</Window>
