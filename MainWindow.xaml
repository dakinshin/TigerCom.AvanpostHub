<Window x:Class="AvanpostHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Avanpost Hub"
        Width="1180"
        Height="960"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/Assets/avanpost.ico"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_Closing">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.08,0.02" GradientOrigin="0.08,0.02" RadiusX="1.05" RadiusY="1.05">
                <GradientStop Color="#10212A" Offset="0"/>
                <GradientStop Color="#0A1017" Offset="0.58"/>
                <GradientStop Color="#080D13" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
            <Grid Margin="34,28,34,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Width="68" Height="68" Stretch="Uniform"
                           Source="pack://application:,,,/Assets/avanpost-mark.png"
                           VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Margin="18,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="AVANPOST HUB" FontSize="27" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Margin="0,5,0,0" MaxWidth="520" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                                   Text="Локальный мост между индикаторами Tiger.com, screener API и рыночными данными Binance."/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="HeaderStatusPill" Background="#143326" BorderBrush="#27624A"
                                BorderThickness="1" CornerRadius="18" Padding="13,7" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="HeaderStatusDot" Width="8" Height="8"
                                         Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="HeaderStatusText" Text="Работает" Margin="8,0,0,0"
                                           Foreground="{StaticResource AccentMintBrush}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Button Content="Настройки" Width="110" Style="{StaticResource SecondaryButtonStyle}"
                                Click="Settings_Click" Margin="0,0,8,0"/>
                        <Button Content="Уведомления" Width="126" Style="{StaticResource SecondaryButtonStyle}"
                                Click="Notifications_Click" Margin="0,0,8,0"/>
                        <Button Content="В трей" Width="78" Style="{StaticResource GhostButtonStyle}"
                                Click="Hide_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Metrics -->
                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,18">
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="СОСТОЯНИЕ" Style="{StaticResource MutedStyle}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="StatusMetricText" Text="ONLINE" Margin="0,10,0,0"
                                       FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock x:Name="StatusMetricDetail" Text="локальный сервер запущен"
                                       Margin="0,5,0,0" Style="{StaticResource CaptionStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="ПОДКЛЮЧЕНИЯ" Style="{StaticResource MutedStyle}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ClientsMetricText" Text="0" Margin="0,10,0,0"
                                       FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="ClientsMetricDetail" Text="0 клиентов · 0 подписок"
                                       Margin="0,5,0,0" Style="{StaticResource CaptionStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="ДАННЫЕ" Style="{StaticResource MutedStyle}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DataMetricText" Text="0" Margin="0,10,0,0"
                                       FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="DataMetricDetail" Text="0 серий · 0 закрытых баров"
                                       Margin="0,5,0,0" Style="{StaticResource CaptionStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="UPTIME" Style="{StaticResource MutedStyle}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="UptimeMetricText" Text="—" Margin="0,10,0,0"
                                       FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="UptimeMetricDetail" Text="версия 0.5.0"
                                       Margin="0,5,0,0" Style="{StaticResource CaptionStyle}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Connectivity diagram -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="22,20,22,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel>
                                <TextBlock Text="Поток данных" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="Индикаторы подключаются к Hub, Hub — к screener и биржам."
                                           Margin="0,5,0,0" Style="{StaticResource CaptionStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="подключено" Margin="6,0,14,0" Style="{StaticResource MutedStyle}"/>
                                <Ellipse Width="7" Height="7" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="ожидание" Margin="6,0,14,0" Style="{StaticResource MutedStyle}"/>
                                <Ellipse Width="7" Height="7" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="нет связи" Margin="6,0,0,0" Style="{StaticResource MutedStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Viewbox Grid.Row="1" Stretch="Uniform" Margin="0,6,0,0" Height="310">
                            <Canvas Width="920" Height="280">
                                <!-- Connections -->
                                <Line x:Name="IndicatorLink" X1="250" Y1="140" X2="332" Y2="140"
                                      Stroke="{StaticResource AccentBrush}" StrokeThickness="3" Opacity="0.82"/>
                                <Path x:Name="ScreenerLink" Data="M 590,140 L 642,140 L 642,70 L 690,70"
                                      Stroke="{StaticResource AccentBrush}" StrokeThickness="3" Opacity="0.82"/>
                                <Path x:Name="ExchangeLink" Data="M 590,140 L 642,140 L 642,210 L 690,210"
                                      Stroke="{StaticResource AccentBrush}" StrokeThickness="3" Opacity="0.82"/>

                                <Ellipse x:Name="IndicatorLinkDot" Canvas.Left="285" Canvas.Top="132"
                                         Width="16" Height="16" Fill="{StaticResource AccentBrush}"/>
                                <Ellipse x:Name="ScreenerLinkDot" Canvas.Left="634" Canvas.Top="62"
                                         Width="16" Height="16" Fill="{StaticResource AccentBrush}"/>
                                <Ellipse x:Name="ExchangeLinkDot" Canvas.Left="634" Canvas.Top="202"
                                         Width="16" Height="16" Fill="{StaticResource AccentBrush}"/>

                                <!-- Indicators -->
                                <Border Canvas.Left="18" Canvas.Top="78" Width="232" Height="124"
                                        Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="13" Padding="16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="IndicatorNodeDot" Width="8" Height="8"
                                                     Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="ИНДИКАТОРЫ TIGER" Margin="8,0,0,0"
                                                       Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                        </StackPanel>
                                        <TextBlock x:Name="IndicatorNodeDetailText" Text="0 клиентов · 0 подписок"
                                                   Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Border Background="#193226" CornerRadius="6" Padding="7,3" Margin="0,0,6,0">
                                                <TextBlock Text="OI Flow" Foreground="{StaticResource AccentMintBrush}" FontSize="10"/>
                                            </Border>
                                            <Border Background="#172B38" CornerRadius="6" Padding="7,3" Margin="0,0,6,0">
                                                <TextBlock Text="Overlay" Foreground="#BAE6FD" FontSize="10"/>
                                            </Border>
                                            <Border Background="#2B2433" CornerRadius="6" Padding="7,3">
                                                <TextBlock Text="Alerts" Foreground="#DDD6FE" FontSize="10"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Hub -->
                                <Border Canvas.Left="332" Canvas.Top="54" Width="258" Height="172"
                                        Background="#10231E" BorderBrush="#2C7558" BorderThickness="1"
                                        CornerRadius="17" Padding="18">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <Image Width="42" Height="42" Source="pack://application:,,,/Assets/avanpost-mark.png"/>
                                            <StackPanel Margin="11,2,0,0">
                                                <TextBlock Text="AVANPOST HUB" Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontSize="15" FontWeight="Bold"/>
                                                <TextBlock x:Name="HubNodeDetailText" Text="ws://127.0.0.1:7830/ws"
                                                           Foreground="{StaticResource TextMutedBrush}" FontSize="10"
                                                           MaxWidth="178" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Row="1" Margin="0,14,0,0" Background="#153B2E" CornerRadius="8" Padding="10,7">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="HubNodeDot" Width="8" Height="8"
                                                         Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="HubNodeStatusText" Text="Сервер работает" Margin="8,0,0,0"
                                                           Foreground="{StaticResource AccentMintBrush}" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="2" Margin="0,11,0,0" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"
                                                   Text="Нормализует поток, историю OI, калибровку и события для индикаторов."/>
                                    </Grid>
                                </Border>

                                <!-- Screener -->
                                <Border Canvas.Left="690" Canvas.Top="18" Width="212" Height="104"
                                        Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="13" Padding="15">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="ScreenerNodeDot" Width="8" Height="8"
                                                     Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="SCREENER API" Margin="8,0,0,0" Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold" FontSize="13"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ScreenerNodeStatusText" Text="калибровка загружена"
                                                   Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="история OI · профиль OiFlow"
                                                   Margin="0,5,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                    </StackPanel>
                                </Border>

                                <!-- Exchanges -->
                                <Border Canvas.Left="690" Canvas.Top="158" Width="212" Height="104"
                                        Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="13" Padding="15">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="ExchangeNodeDot" Width="8" Height="8"
                                                     Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="БИРЖИ" Margin="8,0,0,0" Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold" FontSize="13"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ExchangeNodeStatusText" Text="Binance подключён"
                                                   Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                        <TextBlock x:Name="ExchangeNodeDetailText" Text="0 активных коннекторов"
                                                   Margin="0,5,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Border>

                <!-- Actions and system status -->
                <Grid Grid.Row="3" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Быстрые действия" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Управление локальным сервером и диагностикой."
                                       Margin="0,5,0,16" Style="{StaticResource CaptionStyle}"/>
                            <UniformGrid Columns="2" Rows="2">
                                <Button Content="Перезапустить хаб" Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,6,6" Click="Restart_Click"/>
                                <Button Content="Открыть логи" Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="6,0,0,6" Click="OpenLogs_Click"/>
                                <Button Content="Обновить статус" Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,6,6,0" Click="Refresh_Click"/>
                                <Button Content="Свернуть в трей" Style="{StaticResource GhostButtonStyle}"
                                        Margin="6,6,0,0" Click="Hide_Click"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Система" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Параметры текущего подключения и сервисов."
                                       Margin="0,5,0,16" Style="{StaticResource CaptionStyle}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Endpoint" Style="{StaticResource MutedStyle}" Margin="0,0,0,10"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="EndpointText" Text="—"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                           Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Row="1" Text="Хранилище" Style="{StaticResource MutedStyle}" Margin="0,0,0,10"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="StorageText" Text="—"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                           Margin="0,0,0,10" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="2" Text="Калибровка" Style="{StaticResource MutedStyle}" Margin="0,0,0,10"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CalibrationText" Text="—"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                           Margin="0,0,0,10" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="3" Text="Уведомления" Style="{StaticResource MutedStyle}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="NotificationsText" Text="—"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </Grid>

                            <Border x:Name="ErrorBorder" Visibility="Collapsed" Margin="0,14,0,0"
                                    Background="#341A20" BorderBrush="#6B303A" BorderThickness="1"
                                    CornerRadius="9" Padding="12,9">
                                <StackPanel>
                                    <TextBlock Text="Последняя ошибка" Foreground="#FCA5A5" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ErrorText" Margin="0,4,0,0" Foreground="#FECACA"
                                               FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="4" Margin="2,18,2,0">
                    <TextBlock x:Name="VersionText" Text="Avanpost Hub · 0.5.0"
                               Style="{StaticResource MutedStyle}" VerticalAlignment="Center"/>
                    <TextBlock Text="Tiger.com · screener · Binance"
                               HorizontalAlignment="Right" Style="{StaticResource MutedStyle}"/>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
