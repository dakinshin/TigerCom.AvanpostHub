<Window x:Class="AvanpostHub.NotificationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Транспорт уведомлений · Avanpost Hub"
        Width="680"
        Height="430"
        MinWidth="600"
        MinHeight="390"
        WindowStartupLocation="CenterOwner"
        Background="#F4F5F7">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Транспорт уведомлений" FontSize="24" FontWeight="SemiBold" Foreground="#20242A"/>
            <TextBlock Margin="0,4,0,0" Foreground="#5B6470" TextWrapping="Wrap"
                       Text="Hub только доставляет готовые сообщения в ntfy. Какие сигналы и с какой уверенностью отправлять, настраивается в индикаторе OI Flow Shade."/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="Канал ntfy" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="145"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <CheckBox Grid.Row="0" Grid.Column="1" x:Name="EnabledCheck"
                          Content="Включить транспорт уведомлений" FontWeight="SemiBold"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,12,0,0" VerticalAlignment="Center" Text="Сервер"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="NtfyUrlBox" Margin="0,12,0,0"
                         Height="28" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,10,0,0" VerticalAlignment="Center" Text="Топик"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="NtfyTopicBox" Margin="0,10,0,0"
                         Height="28" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,10,0,0" VerticalAlignment="Center" Text="Access token"/>
                <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="NtfyTokenBox" Margin="0,10,0,0"
                             Height="28" VerticalContentAlignment="Center"/>

                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="TestButton" Content="Отправить тест" Width="130" Height="30" Click="Test_Click"/>
                    <TextBlock x:Name="TestStatusText" Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="#4A5563" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <Border Grid.Row="2" Background="#FFF7E8" BorderBrush="#F0D39A" BorderThickness="1"
                CornerRadius="4" Padding="12" VerticalAlignment="Top">
            <TextBlock Foreground="#8A5A00" TextWrapping="Wrap"
                       Text="Правила вида «сигнал X, минимальная уверенность Y» задаются в настройках OI Flow Shade на графике Tiger. Hub не интерпретирует их и не знает, от какого индикатора пришло сообщение."/>
        </Border>

        <Grid Grid.Row="3">
            <TextBlock VerticalAlignment="Center" Foreground="#7A828C"
                       Text="Топик ntfy — секрет. Не публикуйте его в открытом виде."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить" Width="110" Height="34" Click="Save_Click"/>
                <Button Content="Отмена" Width="100" Height="34" Margin="10,0,0,0" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
