<Window x:Class="AvanpostHub.NotificationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Транспорт уведомлений · Avanpost Hub"
        Width="690"
        Height="590"
        MinWidth="620"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/Assets/avanpost.ico"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Width="52" Height="52" Source="pack://application:,,,/Assets/avanpost-mark.png"/>
            <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Транспорт уведомлений" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Hub доставляет готовые сообщения индикаторов в ntfy."
                           Margin="0,4,0,0" Style="{StaticResource CaptionStyle}"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
            <StackPanel Margin="0,0,4,0">
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <CheckBox x:Name="EnabledCheck" Style="{StaticResource DarkCheckBoxStyle}"
                                  Content="Включить транспорт уведомлений" FontWeight="SemiBold"/>
                        <TextBlock Text="Сервер ntfy" Margin="0,18,0,6" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="NtfyUrlBox" Style="{StaticResource DarkTextBoxStyle}"/>
                        <TextBlock Text="Топик" Margin="0,14,0,6" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="NtfyTopicBox" Style="{StaticResource DarkTextBoxStyle}"/>
                        <TextBlock Text="Access token — необязательно" Margin="0,14,0,6" Style="{StaticResource FieldLabelStyle}"/>
                        <PasswordBox x:Name="NtfyTokenBox" Style="{StaticResource DarkPasswordBoxStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="TestButton" Content="Отправить тест" Width="140"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="Test_Click"/>
                            <TextBlock x:Name="TestStatusText" Margin="14,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#11202A" BorderBrush="#28495A" BorderThickness="1"
                        CornerRadius="12" Padding="15">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource InfoBrush}"
                                 VerticalAlignment="Top" Margin="0,4,10,0"/>
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"
                                   Text="Правила «сигнал → минимальная уверенность» находятся в настройках OI Flow Shade. Hub не интерпретирует сообщения и не знает, от какого индикатора они пришли."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="Топик ntfy является секретом." VerticalAlignment="Center" Style="{StaticResource MutedStyle}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Width="105" Style="{StaticResource SecondaryButtonStyle}"
                        Click="Cancel_Click" Margin="0,0,10,0" IsCancel="True"/>
                <Button Content="Сохранить" Width="120" Style="{StaticResource PrimaryButtonStyle}"
                        Click="Save_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
